.guide-card {
  overflow: hidden;
  padding: 0;
  margin-bottom: 24rpx;
  position: relative;
}

.guide-card::before {
  content: '✧';
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 215, 0, 0.4);
  z-index: 2;
}

.card-cover-wrap {
  position: relative;
}

.card-cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

/* 景点名称标签 */
.card-cover-spot {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  color: #fff;
  background: rgba(255, 107, 157, 0.9);
  backdrop-filter: blur(8px);
  max-width: 65%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 私密标记 */
.card-cover-private {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
}

/* 城市标签 */
.card-cover-city {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
}

.card-info {
  padding: 20rpx 24rpx 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5A4A5A;
  line-height: 1.5;
  min-height: 90rpx;
}

.card-meta {
  margin-top: 12rpx;
}

.card-food-count {
  font-size: 22rpx;
  color: #B088F9;
}

.card-bottom {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed rgba(255, 107, 157, 0.2);
}

.author-avatar-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  padding: 3rpx;
  background: linear-gradient(135deg, #FF6B9D, #FFD0E0);
  margin-right: 12rpx;
}

.author-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.author-name {
  font-size: 24rpx;
  color: #CC88AA;
  max-width: 160rpx;
}

.card-stats {
  gap: 20rpx;
}

.stat-item {
  gap: 6rpx;
}

.stat-heart {
  font-size: 24rpx;
  color: #FF6B9D;
}

.stat-eye {
  font-size: 24rpx;
}

.stat-num {
  font-size: 22rpx;
  color: #CCBBCC;
}
