.page-edit {
  padding: 20rpx 24rpx;
  padding-bottom: 180rpx;
}

.form {
  padding: 28rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8FA 100%);
  border: 2rpx solid rgba(255, 107, 157, 0.1);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #5A4A5A;
  margin-bottom: 16rpx;
  display: block;
}

.form-label::before {
  content: '♡ ';
  color: #FF6B9D;
}

.required {
  color: #FF4444;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.2);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: rgba(255, 245, 247, 0.5);
  color: #5A4A5A;
}

.form-textarea {
  width: 100%;
  height: 300rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
  background: rgba(255, 245, 247, 0.5);
  color: #5A4A5A;
}

/* 美食列表 */
.foods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.food-item {
  padding: 20rpx;
  background: rgba(255, 245, 247, 0.5);
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.1);
}

.food-item-header {
  margin-bottom: 12rpx;
}

.food-index {
  font-size: 26rpx;
  color: #FF6B9D;
  font-weight: 600;
}

.food-delete {
  font-size: 24rpx;
  color: #CCBBCC;
}

.food-input {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.15);
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.6);
  color: #5A4A5A;
  margin-bottom: 12rpx;
}

.food-input:last-child {
  margin-bottom: 0;
}

.food-add {
  text-align: center;
  padding: 24rpx;
  border: 3rpx dashed rgba(255, 107, 157, 0.25);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #FF6B9D;
  background: rgba(255, 245, 247, 0.3);
}

/* 图片 */
.image-list {
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.15);
}

.image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed rgba(255, 107, 157, 0.3);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: rgba(255, 245, 247, 0.5);
}

.add-icon {
  font-size: 56rpx;
  color: #FFD0E0;
}

.add-text {
  font-size: 22rpx;
  color: #FFD0E0;
}

/* 保存按钮 */
.save-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  box-shadow: 0 -4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.save-btn {
  width: 100%;
}
