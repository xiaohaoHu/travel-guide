.page-detail {
  padding-bottom: 120rpx;
}

/* 轮播图 */
.detail-swiper {
  width: 100%;
  height: 500rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 头部信息 */
.detail-header {
  margin-top: 20rpx;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #5A4A5A;
  line-height: 1.4;
  display: block;
}

.detail-meta {
  margin-top: 20rpx;
  gap: 16rpx;
  align-items: center;
}

.detail-region-tag {
  font-size: 24rpx;
  color: #FF6B9D;
  background: rgba(255, 107, 157, 0.1);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.detail-time {
  font-size: 24rpx;
  color: #CCBBCC;
}

/* 景点名称 */
.detail-spot {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  border-radius: 28rpx;
  gap: 8rpx;
}

.detail-spot-icon {
  font-size: 26rpx;
}

.detail-spot-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.detail-author {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(255, 107, 157, 0.2);
}

.author-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  padding: 3rpx;
  background: linear-gradient(135deg, #FF6B9D, #FFD0E0);
  margin-right: 16rpx;
}

.author-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.author-name {
  font-size: 28rpx;
  color: #5A4A5A;
}

/* 正文 */
.detail-content {
  margin-top: 20rpx;
  position: relative;
}

.content-deco {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  font-size: 60rpx;
  color: rgba(255, 107, 157, 0.08);
}

/* 隐私设置+编辑（仅作者） */
.detail-author-actions {
  margin-top: 20rpx;
}

.author-action-row {
  align-items: center;
  margin-bottom: 20rpx;
}

.edit-btn {
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 157, 0.3);
}

.delete-btn {
  text-align: center;
  padding: 20rpx;
  margin-top: 16rpx;
  background: #fff;
  color: #FF4444;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #FF4444;
}

.privacy-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5A4A5A;
  display: block;
}

.privacy-desc {
  font-size: 22rpx;
  color: #CCBBCC;
  margin-top: 4rpx;
  display: block;
}

.content-text {
  font-size: 30rpx;
  color: #5A4A5A;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 美食推荐 */
.detail-foods {
  margin-top: 20rpx;
}

.foods-header {
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.foods-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5A4A5A;
}

.foods-count {
  font-size: 22rpx;
  color: #FF6B9D;
  background: rgba(255, 107, 157, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.foods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.food-card {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF5F7 0%, #FFF0FF 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.1);
}

.food-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  margin-top: 10rpx;
  flex-shrink: 0;
}

.food-info {
  flex: 1;
}

.food-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #5A4A5A;
  display: block;
}

.food-reason {
  font-size: 24rpx;
  color: #CC88AA;
  margin-top: 6rpx;
  display: block;
  line-height: 1.5;
}

/* 互动栏 */
.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  padding: 16rpx 0 env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(255, 107, 157, 0.1);
  justify-content: space-around;
  z-index: 100;
}

.action-item {
  gap: 4rpx;
}

.action-icon {
  font-size: 44rpx;
  color: #CCBBCC;
}

.action-text {
  font-size: 22rpx;
  color: #CCBBCC;
}

.action-item.liked .action-icon {
  color: #FF6B9D;
}

.action-item.liked .action-text {
  color: #FF6B9D;
}

.action-item.favorited .action-icon {
  color: #FFD700;
}

.action-item.favorited .action-text {
  color: #FFD700;
}
