.page-index {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB1 100%);
}

.search-input {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  height: 72rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  color: #FF6B9D;
}

.search-placeholder {
  color: #CCBBCC;
  font-size: 28rpx;
}

.search-star {
  font-size: 24rpx;
  color: #FFD700;
  margin-left: auto;
}

/* 浪漫横幅 */
.love-banner {
  margin: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF0F3 0%, #FDE8F0 50%, #F0E0FF 100%);
  text-align: center;
  padding: 36rpx 24rpx;
  position: relative;
  overflow: hidden;
}

.banner-deco {
  position: absolute;
  top: -10rpx;
  right: 20rpx;
  font-size: 80rpx;
  color: rgba(255, 107, 157, 0.12);
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF6B9D;
  display: block;
}

.banner-sub {
  font-size: 24rpx;
  color: #CC88AA;
  margin-top: 12rpx;
  display: block;
}

/* 区块 */
.section {
  margin-top: 16rpx;
}

.section-header {
  padding: 0 24rpx 16rpx;
}

.section-icon {
  font-size: 28rpx;
  color: #FFD700;
  margin-right: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5A4A5A;
}

.section-more {
  font-size: 26rpx;
  color: #FF6B9D;
}

/* 热门地区滚动 */
.region-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.region-list {
  gap: 20rpx;
}

.region-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.region-cover-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.region-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
  border: 4rpx solid rgba(255, 107, 157, 0.3);
}

.region-cover-text {
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1, #E8B4F8);
}

.region-cover-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.region-cover-prov {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.region-heart {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 44rpx;
  height: 44rpx;
  background: #FF6B9D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.4);
}

.region-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5A4A5A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160rpx;
}

/* 排序导航栏 */
.sort-bar {
  padding: 20rpx 24rpx 16rpx;
  gap: 24rpx;
  align-items: center;
}

.sort-item {
  font-size: 28rpx;
  color: #CCBBCC;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.15);
}

.sort-active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  border-color: #FF6B9D;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}

.sort-divider {
  color: #FFD0E0;
  font-size: 24rpx;
}

/* 攻略网格 - CSS Grid确保一行2个 */
.guide-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 0 20rpx;
  gap: 16rpx;
}

.guide-grid-item {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 107, 157, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.08);
}

.grid-cover-wrap {
  position: relative;
  overflow: hidden;
}

.grid-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.grid-spot {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  color: #fff;
  background: rgba(255, 107, 157, 0.9);
  max-width: 85%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-grid-item {
  position: relative;
}

.grid-info {
  padding: 14rpx 16rpx 16rpx;
}

.grid-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5A4A5A;
  line-height: 1.4;
  min-height: 72rpx;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.grid-meta {
  margin-top: 8rpx;
}

.grid-city {
  font-size: 20rpx;
  color: #CC88AA;
}

.grid-bottom {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(255, 107, 157, 0.08);
}

.grid-food {
  font-size: 20rpx;
  color: #B088F9;
}

.grid-heart {
  font-size: 20rpx;
  color: #FF6B9D;
}

/* 空状态 */
.empty-wrap {
  text-align: center;
  padding: 100rpx 0;
}

.empty-hearts {
  font-size: 48rpx;
  color: #FFD0E0;
  letter-spacing: 16rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #CC88AA;
  margin-top: 24rpx;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #DDAACC;
  margin-top: 12rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #CCBBCC;
}
