.page-index {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB1 100%);
}

.search-input {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  height: 72rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  color: #FF6B9D;
}

.search-placeholder {
  color: #CCBBCC;
  font-size: 28rpx;
}

.search-star {
  font-size: 24rpx;
  color: #FFD700;
  margin-left: auto;
}

/* 浪漫横幅 */
.love-banner {
  margin: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF0F3 0%, #FDE8F0 50%, #F0E0FF 100%);
  text-align: center;
  padding: 36rpx 24rpx;
  position: relative;
  overflow: hidden;
}

.banner-deco {
  position: absolute;
  top: -10rpx;
  right: 20rpx;
  font-size: 80rpx;
  color: rgba(255, 107, 157, 0.12);
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF6B9D;
  display: block;
}

.banner-sub {
  font-size: 24rpx;
  color: #CC88AA;
  margin-top: 12rpx;
  display: block;
}

/* 区块 */
.section {
  margin-top: 16rpx;
}

.section-header {
  padding: 0 24rpx 16rpx;
}

.section-icon {
  font-size: 28rpx;
  color: #FFD700;
  margin-right: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5A4A5A;
}

.section-more {
  font-size: 26rpx;
  color: #FF6B9D;
}

/* 热门地区滚动 */
.region-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.region-list {
  gap: 20rpx;
}

.region-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.region-cover-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.region-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
  border: 4rpx solid rgba(255, 107, 157, 0.3);
}

/* 城市文字封面 */
.region-cover-text {
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1, #E8B4F8);
}

.region-cover-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.region-cover-prov {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.region-heart {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 44rpx;
  height: 44rpx;
  background: #FF6B9D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.4);
}

.region-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5A4A5A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160rpx;
}

/* 攻略列表标题 */
.guide-list-header {
  margin-top: 12rpx;
}

.section-icon {
  font-size: 28rpx;
  color: #FFD700;
  margin-right: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5A4A5A;
}

/* 攻略列表 */
.guide-list {
  padding: 20rpx 24rpx;
}

/* 空状态 */
.empty-wrap {
  text-align: center;
  padding: 100rpx 0;
}

.empty-hearts {
  font-size: 48rpx;
  color: #FFD0E0;
  letter-spacing: 16rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #CC88AA;
  margin-top: 24rpx;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #DDAACC;
  margin-top: 12rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #CCBBCC;
}
