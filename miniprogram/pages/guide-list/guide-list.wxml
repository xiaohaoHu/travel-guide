<view class="page-guide-list">
  <!-- 筛选区 -->
  <view class="filter-bar card">
    <!-- 排序 -->
    <view class="filter-row flex-between">
      <view class="filter-label">排序</view>
      <view class="filter-options flex-row">
        <view
          class="filter-tag {{currentSort === 'latest' ? 'filter-active' : ''}}"
          bindtap="switchSort"
          data-sort="latest"
        >最新</view>
        <view
          class="filter-tag {{currentSort === 'hot' ? 'filter-active' : ''}}"
          bindtap="switchSort"
          data-sort="hot"
        >最热</view>
      </view>
    </view>
    <!-- 当前城市（如有） -->
    <view class="current-region flex-row" wx:if="{{city}}">
      <text class="region-label">📍 {{city}}</text>
      <text class="region-clear" bindtap="clearCity">清除 ✕</text>
    </view>
  </view>

  <!-- 攻略列表 -->
  <view class="guide-list" wx:if="{{guides.length > 0}}">
    <guide-card
      wx:for="{{guides}}"
      wx:key="_id"
      guide="{{item}}"
    />
  </view>

  <empty-state wx:if="{{!loading && guides.length === 0}}" message="暂无符合条件的攻略 ♡" />

  <view class="load-more" wx:if="{{loading}}">
    <text class="twinkle">♡</text>
    <text> 加载中...</text>
  </view>
  <view class="load-more" wx:if="{{!loading && noMore && guides.length > 0}}">
    <text>- 没有更多啦 ♡ -</text>
  </view>
</view>
